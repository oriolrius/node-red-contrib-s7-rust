{
  "name": "node-red-contrib-s7-rust",
  "version": "1.1.0",
  "description": "Siemens S7 nodes for Node-RED: S7comm and S7CommPlus (S7-1200/1500 symbolic access) clients written in Rust, running in-process (Node-API). Linux x64.",
  "keywords": [
    "node-red",
    "siemens",
    "s7",
    "s7comm",
    "s7commplus",
    "s7-1200",
    "s7-1500",
    "s7-300",
    "logo",
    "plc",
    "industrial",
    "iiot",
    "rust",
    "napi"
  ],
  "homepage": "https://github.com/oriolrius/node-red-contrib-s7-rust#readme",
  "bugs": {
    "url": "https://github.com/oriolrius/node-red-contrib-s7-rust/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriolrius/node-red-contrib-s7-rust.git"
  },
  "license": "LGPL-3.0-only",
  "author": "Oriol Rius",
  "main": "lib/napi-bridge.js",
  "files": [
    "lib/",
    "nodes/",
    "bin/linux-x64-gnu/s7napi.node",
    "bin/linux-x64-musl/s7napi.node",
    "examples/",
    "NOTICE",
    "COPYING",
    "CHANGELOG.md"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "s7rs-endpoint": "nodes/s7rs-endpoint.js",
      "s7rs-read": "nodes/s7rs-read.js",
      "s7rs-write": "nodes/s7rs-write.js",
      "s7rs-watch": "nodes/s7rs-watch.js",
      "s7rs-info": "nodes/s7rs-info.js",
      "s7rs-alarms": "nodes/s7rs-alarms.js"
    }
  },
  "scripts": {
    "build": "sh scripts/build.sh dev",
    "build:release": "sh scripts/build.sh release",
    "test": "npm run test:rust && npm run test:node",
    "test:rust": "cargo test --workspace --features s7plus/fake",
    "test:node": "sh scripts/build.sh test-addon && node --test test/*.test.js",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets --features s7plus/fake,s7/fakecpu,s7napi/fake -- -D warnings",
    "validate": "npx --yes node-red-dev@latest validate",
    "prepack": "node scripts/check-pack.js"
  },
  "devDependencies": {
    "node-red": "^5.0.0",
    "node-red-4": "npm:node-red@^4.1.17",
    "node-red-node-test-helper": "^0.3.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "multer": "^2.5.0",
    "body-parser@1": "^1.20.9",
    "npm": "~11.21.2"
  }
}
